{
  "id": "dm-notification",
  "name": "dm-notification",
  "version": "0.1.0",
  "installed_at": "1778587320",
  "source": {
    "build": "pip install -e .",
    "github": null
  },
  "description": "System notification utility node. Turns incoming text into a desktop notification and emits JSON status.",
  "executable": ".venv/bin/dm-notification",
  "maintainers": [
    {
      "name": "Dora Manager"
    }
  ],
  "display": {
    "category": "Builtin/Desktop Tools",
    "tags": [
      "builtin",
      "desktop",
      "notification",
      "utility"
    ]
  },
  "capabilities": [
    "configurable",
    {
      "name": "desktop_output",
      "bindings": [
        {
          "role": "sink",
          "port": "message",
          "channel": "notification",
          "media": [
            "text"
          ],
          "lifecycle": [
            "run_scoped",
            "permissioned"
          ],
          "description": "Shows incoming text as a system notification."
        }
      ]
    }
  ],
  "needs": [
    "dm-server"
  ],
  "runtime": {
    "language": "python",
    "python": ">=3.10",
    "platforms": [
      "macos",
      "linux",
      "windows"
    ]
  },
  "ports": [
    {
      "id": "message",
      "name": "message",
      "direction": "input",
      "description": "Notification body.",
      "required": false,
      "multiple": false,
      "schema": {
        "type": {
          "name": "utf8"
        }
      }
    },
    {
      "id": "status",
      "name": "status",
      "direction": "output",
      "description": "Notification delivery status as JSON.",
      "required": false,
      "multiple": false,
      "schema": {
        "type": {
          "name": "utf8"
        }
      }
    }
  ],
  "files": {
    "readme": "README.md",
    "entry": "dm_notification/main.py",
    "tests": [],
    "examples": [
      "demos/demo-desktop-tools.yml"
    ]
  },
  "examples": [
    {
      "title": "Desktop tools demo",
      "path": "demos/demo-desktop-tools.yml",
      "description": "Show a system notification when a screenshot is captured."
    }
  ],
  "config_schema": {
    "title": {
      "default": "Dora Manager",
      "description": "Notification title.",
      "env": "TITLE"
    },
    "subtitle": {
      "default": "",
      "description": "Optional notification subtitle or app name hint.",
      "env": "SUBTITLE"
    },
    "sound": {
      "default": "",
      "description": "Optional macOS notification sound name.",
      "env": "SOUND"
    },
    "send_frontend_status": {
      "default": true,
      "description": "Also send notification status to the run UI.",
      "env": "SEND_FRONTEND_STATUS",
      "x-widget": {
        "type": "switch"
      }
    }
  },
  "dynamic_ports": false,
  "path": ""
}
