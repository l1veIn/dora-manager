{
  "id": "dm-open",
  "name": "dm-open",
  "version": "0.1.0",
  "installed_at": "1778587330",
  "source": {
    "build": "pip install -e .",
    "github": null
  },
  "description": "Open files, folders, or URLs from a Dora dataflow and emit JSON status.",
  "executable": ".venv/bin/dm-open",
  "maintainers": [
    {
      "name": "Dora Manager"
    }
  ],
  "display": {
    "category": "Builtin/Desktop Tools",
    "tags": [
      "builtin",
      "desktop",
      "open",
      "utility"
    ]
  },
  "capabilities": [
    "configurable",
    {
      "name": "desktop_output",
      "bindings": [
        {
          "role": "sink",
          "port": "target",
          "channel": "open",
          "media": [
            "text",
            "path",
            "url"
          ],
          "lifecycle": [
            "run_scoped",
            "permissioned"
          ],
          "description": "Opens incoming file paths, folders, or URLs with the host OS."
        }
      ]
    }
  ],
  "needs": [
    "dm-server"
  ],
  "runtime": {
    "language": "python",
    "python": ">=3.10",
    "platforms": [
      "macos",
      "linux",
      "windows"
    ]
  },
  "ports": [
    {
      "id": "target",
      "name": "target",
      "direction": "input",
      "description": "File path, folder path, or URL to open.",
      "required": false,
      "multiple": false,
      "schema": {
        "type": {
          "name": "utf8"
        }
      }
    },
    {
      "id": "status",
      "name": "status",
      "direction": "output",
      "description": "Open operation status as JSON.",
      "required": false,
      "multiple": false,
      "schema": {
        "type": {
          "name": "utf8"
        }
      }
    }
  ],
  "files": {
    "readme": "README.md",
    "entry": "dm_open/main.py",
    "tests": [],
    "examples": [
      "demos/demo-desktop-tools.yml"
    ]
  },
  "examples": [
    {
      "title": "Desktop tools demo",
      "path": "demos/demo-desktop-tools.yml",
      "description": "Open the latest screenshot artifact from a dataflow."
    }
  ],
  "config_schema": {
    "target": {
      "default": "",
      "description": "Optional target to open on startup.",
      "env": "TARGET"
    },
    "reveal": {
      "default": false,
      "description": "On macOS, reveal a file in Finder instead of opening it.",
      "env": "REVEAL",
      "x-widget": {
        "type": "switch"
      }
    },
    "send_frontend_status": {
      "default": true,
      "description": "Also send open status to the run UI.",
      "env": "SEND_FRONTEND_STATUS",
      "x-widget": {
        "type": "switch"
      }
    }
  },
  "dynamic_ports": false,
  "path": ""
}
